---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import ebGaramondRegular from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';
// Preloaded so `font-display: optional` (global.css) usually gets it in time for the arrival's name (decision #10).
import cormorantDisplay from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import arrivalScript from '../scripts/arrival.js?raw';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Project pages reserve room at the sides for the fixed prev/next edge wings. */
  edges?: boolean;
  /** Home only: run the arrival (spec 5.3). */
  arrival?: boolean;
}
const { title, description = SITE.tagline, edges = false, arrival = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${SITE.name}` : SITE.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={ebGaramondRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorantDisplay} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // M13: images fade in from their blurred placeholder once loaded (or failed). Without JS they simply show.
      document.documentElement.classList.add('js');
      // On document, not window: element load events never reach window.
      for (const type of ['load', 'error']) {
        document.addEventListener(type, (e) => e.target instanceof HTMLImageElement && e.target.classList.add('loaded'), true);
      }
    </script>
    {arrival && <script is:inline set:html={arrivalScript} />}
    <slot name="head" />
  </head>
  <body class:list={{ 'has-edges': edges }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
