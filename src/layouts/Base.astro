---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Project pages reserve room at the sides for the fixed prev/next edge wings. */
  edges?: boolean;
}
const { title, description = SITE.tagline, edges = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${SITE.name}` : SITE.name}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={{ 'has-edges': edges }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
