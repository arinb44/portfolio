---
import { Image } from 'astro:assets';
import grisailleLeft from '../assets/art/cellier-left.jpg';
import grisailleRight from '../assets/art/cellier-right.jpg';

interface Props {
  side: 'left' | 'right';
  title: string;
}
const { side, title } = Astro.props;
const id = `wing-${side}-title`;
---
<section class={`wing wing-${side}`} aria-labelledby={id}>
  <div class="wing-front">
    <h2 id={id}>{title}</h2>
    <slot />
  </div>
  <!-- Grisaille back face (Cellier Altarpiece), seen only while the arrival plays; arrival.css decides when it exists. -->
  <Image class="wing-back" src={side === 'left' ? grisailleLeft : grisailleRight} alt="" widths={[300, 600]} sizes="25vw" />
</section>
