---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import joseph from '../assets/art/merode-joseph.jpg';
import Wing from './Wing.astro';
import MainPanel from './MainPanel.astro';
import { SITE } from '../site';
import '../styles/arrival.css';

interface Props {
  featured: CollectionEntry<'projects'>;
}
---
<!-- The open altarpiece is the HTML default; the arrival (Milestone 4) only animates towards it. -->
<div class="altarpiece">
  <!-- Closed exterior, shown only while the arrival plays. The name repeats the header's h1, so it is hidden from screen readers. -->
  <div class="exterior">
    <p class="inscription" aria-hidden="true">
      <span class="inscription-name">{SITE.name}</span>
      <span class="inscription-line">{SITE.tagline}</span>
      <span class="inscription-hint">Open ▸ (click · scroll · any key)</span>
    </p>
    <button type="button" class="skip-intro">Skip intro</button>
  </div>
  <Wing side="left" title="About">
    <p>{SITE.tagline}</p>
    <p><a href="/about/">Read more<span class="visually-hidden"> about me</span><span aria-hidden="true"> →</span></a></p>
  </Wing>
  <MainPanel project={Astro.props.featured} />
  <Wing side="right" title="Contact">
    <ul class="link-list">
      <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      <li><a href={SITE.github}>GitHub<span aria-hidden="true"> ↗</span></a></li>
      <li><a href="/cv.pdf">CV (PDF)</a></li>
    </ul>
    <!-- A maker's emblem (spec 7.1). -->
    <Picture class="emblem" src={joseph} alt="Detail of Joseph in his workshop, from the Merode Altarpiece (Workshop of Robert Campin, c. 1427–32)." formats={['avif', 'webp']} widths={[240, 480]} sizes="12rem" />
  </Wing>
</div>
