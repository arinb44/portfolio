---
import type { CollectionEntry } from 'astro:content';
import PredellaScene from './PredellaScene.astro';

type Project = CollectionEntry<'projects'>;
interface Props {
  projects: Project[];
}

// Neighbouring projects in the same series share one labelled sub-list (decision #21).
const groups: { series?: Project['data']['series']; items: Project[] }[] = [];
for (const p of Astro.props.projects) {
  const last = groups.at(-1);
  if (p.data.series && last?.series === p.data.series) last.items.push(p);
  else groups.push({ series: p.data.series, items: [p] });
}
const SERIES_LABEL = { prediction: 'Prediction series' };
---
<nav class="predella" aria-label="Projects">
  <ul>
    {groups.map(({ series, items }) =>
      series ? (
        <li class="series">
          <span id={`series-${series}`}>{SERIES_LABEL[series]}</span>
          <ul aria-labelledby={`series-${series}`}>
            {items.map((p) => <li><PredellaScene project={p} /></li>)}
          </ul>
        </li>
      ) : (
        <li><PredellaScene project={items[0]} /></li>
      ),
    )}
  </ul>
</nav>
