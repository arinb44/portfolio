---
import { SITE } from '../site';

// Same name and nav as the home page (index.astro), where "Projects" starts the reveal instead.
const path = Astro.url.pathname.replace(/\/?$/, '/');
const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
  { href: SITE.cv, label: 'CV' },
  { href: `mailto:${SITE.email}`, label: 'Email' },
];
---
<header class="site-header">
  <a class="site-name" href="/">{SITE.name}</a>
  <nav aria-label="Site">
    <ul>
      {links.map(({ href, label }) => (
        <li><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
  </nav>
</header>
