---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';

interface Props {
  /** All four layers; the first is shown in the page hero, so this renders layers 2-4. */
  layers: CollectionEntry<'projects'>['data']['layers'];
}
const HEADING: Record<string, string> = {
  paint: 'Key features and results',
  underpainting: 'Architecture',
  underdrawing: 'Origins',
};
const STATUS = { finished: 'Finished', 'in-progress': 'In progress' };
---
{Astro.props.layers.slice(1).map((layer) => (
  <section class="section" aria-labelledby={`section-${layer.name}`}>
    <p class="label">{STATUS[layer.status]}</p>
    <h2 id={`section-${layer.name}`}>{HEADING[layer.name]}</h2>
    <p>{layer.text}</p>
    {layer.images.map((img) => (
      <figure>
        <Picture src={img.src} alt={img.alt} formats={['avif', 'webp']} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 48rem, 100vw" loading="lazy" />
        <figcaption>{img.caption}</figcaption>
      </figure>
    ))}
  </section>
))}
