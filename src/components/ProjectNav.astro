---
import Arrow from './Arrow.astro';
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>;
interface Props {
  prev: Project;
  next: Project;
}
const { prev, next } = Astro.props;
const href = (p: Project) => `/projects/${p.id}/`;
---
<nav class="project-nav" aria-label="Previous and next project">
  <a rel="prev" href={href(prev)}><Arrow dir="left" /><span class="visually-hidden">Previous: </span>{prev.data.title}</a>
  <a rel="next" href={href(next)}>Next: {next.data.title}<Arrow dir="right" /></a>
</nav>
