---
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>;
interface Props {
  prev: Project;
  next: Project;
}
const { prev, next } = Astro.props;
const href = (p: Project) => `/projects/${p.id}/`;
---
<nav class="project-nav" aria-label="Previous and next project">
  <a rel="prev" href={href(prev)}><span aria-hidden="true">← </span><span class="visually-hidden">Previous: </span>{prev.data.title}</a>
  <a rel="next" href={href(next)}>Next: {next.data.title}<span aria-hidden="true"> →</span></a>
</nav>
