---
// One drawn arrow for every link mark outside the home page: "out" for links that leave the site, "left"/"right" for prev/next.
interface Props {
  dir?: 'out' | 'left' | 'right';
}
const { dir = 'out' } = Astro.props;
const path = { out: 'M4.5 11.5 11.5 4.5M6 4.5h5.5V10', left: 'M12.5 8h-9m4-4-4 4 4 4', right: 'M3.5 8h9m-4-4 4 4-4 4' }[dir];
---
<svg class={`arrow arrow-${dir}`} viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d={path} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
