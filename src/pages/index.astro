---
import { Image } from 'astro:assets';
import Head from '../components/Head.astro';
import { getProjects } from '../lib/projects';
import { SITE } from '../site';
import '../styles/creation.css';

// Featured first, then `order` (design decision #3).
const sorted = await getProjects();
const projects = [...sorted.filter((p) => p.data.featured), ...sorted.filter((p) => !p.data.featured)];
const two = (n: number) => String(n).padStart(2, '0');
---
<!doctype html>
<!-- Without JavaScript the page stays in its finished state: the projects over the first project's image. -->
<html lang="en" class="static revealed">
  <head>
    <Head />
    <script is:inline>document.documentElement.classList.remove('static', 'revealed');</script>
  </head>
  <body>
    <button class="skip-intro" type="button">Skip intro</button>
    <a class="skip" href="#projects">Skip to the projects</a>
    <div class="computer-only"><p><strong>This site needs a computer.</strong>It's built around a mouse or trackpad. Please open it on a laptop or desktop.</p></div>
    <!-- Each project's main image, full screen behind its card. Decoration: the card carries the project's name and text. -->
    <div class="visuals" aria-hidden="true">
      {projects.map(({ id, data }, i) => (
        <Image src={data.layers[0].images[0].src} alt="" widths={[960, 1600]} sizes="100vw" loading={i === 0 ? 'eager' : 'lazy'} data-for={id} class={i === 0 ? 'on' : undefined} />
      ))}
    </div>
    <canvas id="intro" aria-hidden="true"></canvas>
    <div class="flash" aria-hidden="true"></div>
    <header class="site">
      <div><h1>{SITE.name}</h1><p class="tagline">{SITE.tagline}</p></div>
      <nav aria-label="Site"><ul>
        <li><a href="#projects">Projects</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href={SITE.cv}>CV</a></li>
        <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      </ul></nav>
    </header>
    <main id="projects" tabindex="-1">
      <h2 class="visually-hidden">Projects</h2>
      <div class="stops">
        {projects.map(({ id, data }, i) => (
          <section class="stop" id={id} aria-labelledby={`t-${id}`}>
            <article class="card">
              <p class="count">{two(i + 1)} / {two(projects.length)}{data.featured && ' · Featured'}</p>
              <h3 id={`t-${id}`}>{data.title}</h3>
              <p class="line">{data.oneLine}</p>
              <p class="meta">{data.year} · {data.stack.join(', ')}</p>
              <p class="links">
                <a class="primary" href={`/projects/${id}/`}>View project<span class="visually-hidden">: {data.title}</span></a>
                {data.demo.url && <a href={data.demo.url} target="_blank" rel="noopener">Live demo<span aria-hidden="true"> ↗</span></a>}
                <a href={data.repo} target="_blank" rel="noopener">Code<span aria-hidden="true"> ↗</span></a>
              </p>
              {i < projects.length - 1 && <p class="next" aria-hidden="true">Scroll for the next project</p>}
            </article>
          </section>
        ))}
      </div>
    </main>
    <script>
      import { startPage } from '../scripts/home.js';
      startPage();
    </script>
  </body>
</html>
