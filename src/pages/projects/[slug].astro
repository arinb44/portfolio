---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { Picture, getImage } from 'astro:assets';
import ProjectLayers from '../../components/ProjectLayers.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import { getProjects } from '../../lib/projects';
import { neighbours } from '../../lib/order.ts';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, ...neighbours(projects, project.id) },
  }));
}) satisfies GetStaticPaths;

const { project, prev, next } = Astro.props;
const { data } = project;
const lead = data.layers[0];
const hero = lead.images[0];
const coldStart = data.demo.url && (data.demo.coldStartSeconds ?? 0) > 10 ? data.demo.coldStartSeconds : undefined;
// A project with a video plays it in the hero, with the hero image as its poster (output/project-info/plan.md, Req 7).
const poster = data.video ? await getImage({ src: hero.src, format: 'webp', width: 1600 }) : undefined;
---
<Base title={data.title} description={data.oneLine}>
  <article class="project">
    <!-- Result first: everything a reviewer needs is in this block. -->
    <header class="project-hero">
      <div class="project-summary">
        <p class="label">{data.year}{data.featured && ' · Featured'}</p>
        <h1>{data.title}</h1>
        <p class="one-line">{data.oneLine}</p>
        {data.metric && (
          <p class="metric">
            <strong>{data.metric.value}</strong> {data.metric.label}
            <span class="metric-context">{data.metric.baseline && `vs ${data.metric.baseline} · `}{data.metric.context}</span>
          </p>
        )}
        <p class="meta">Role: {data.role}</p>
        <p class="meta">{data.stack.join(', ')}</p>
        <p class="actions">
          {data.demo.url && <a class="button" href={data.demo.url}>Live demo<span aria-hidden="true"> ↗</span></a>}
          <a href={data.repo}>Code<span aria-hidden="true"> ↗</span></a>
        </p>
        {coldStart && (
          <p class="note">The demo's server sleeps when idle, so its first load can take up to {coldStart} seconds.</p>
        )}
      </div>
      <figure class="project-figure">
        {poster ? (
          <video muted loop playsinline controls preload="metadata" poster={poster.src} aria-label={hero.alt}>
            <source src={`${data.video}.webm`} type="video/webm" />
            <source src={`${data.video}.mp4`} type="video/mp4" />
            <track kind="captions" src={`${data.video}.vtt`} srclang="en" label="English (sounds)" />
          </video>
        ) : (
          <Picture src={hero.src} alt={hero.alt} formats={['avif', 'webp']} widths={[480, 800, 1200, 1600]} sizes="(min-width: 48rem) 55vw, 100vw" loading="eager" fetchpriority="high" />
        )}
        <figcaption>{hero.caption}</figcaption>
      </figure>
      <p class="lead-text">{lead.text}</p>
    </header>
    <ProjectLayers layers={data.layers} />
  </article>
  <ProjectNav prev={prev} next={next} />
</Base>

<script>
  // The hero video starts on its own only when the visitor hasn't asked for reduced motion; otherwise the poster stays.
  const video = document.querySelector<HTMLVideoElement>('.project-figure video');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches) video.play().catch(() => {});
</script>
