---
import Arrow from '../../components/Arrow.astro';
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
// Featured first, then `order`, as on the home page.
const rows = [...projects.filter((p) => p.data.featured), ...projects.filter((p) => !p.data.featured)];
---
<Base title="Projects" description="Five projects: three game predictors, a horror game and a generative art piece.">
  <div class="folio-index">
    <h1>Projects</h1>
    <ul class="index-list" aria-label="All projects">
      {rows.map(({ id, data }) => (
        <li class="index-row">
          <div class="index-plate">
            <Image src={data.layers[0].images[0].src} alt="" widths={[400, 800]} sizes="(min-width: 48rem) 20rem, 100vw" loading="lazy" />
          </div>
          <div class="index-text">
            <h2><a href={`/projects/${id}/`}>{data.title}</a></h2>
            <p>{data.oneLine}</p>
            {data.metric && (
              <p class="index-result"><strong>{data.metric.value}</strong> {data.metric.label}{data.metric.baseline && <>, against {data.metric.baseline}</>}</p>
            )}
            <p class="meta">{data.year} · {data.stack.join(', ')}</p>
            <p class="actions">
              {data.demo.url && (
                <span><a href={data.demo.url}>Live demo<Arrow /></a>{(data.demo.coldStartSeconds ?? 0) > 10 && <span class="slow">(slow start)</span>}</span>
              )}
              {data.demo.kind === 'video' && <a href={`/projects/${id}/`}>Video on its page</a>}
              <a href={data.repo}>Code<Arrow /></a>
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Base>
